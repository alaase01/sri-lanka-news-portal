// RSnewslk.com database schema.
// Design: a language-neutral identity row plus one translation row per language
// for every piece of reader-facing content. See docs/architecture.md.
//
// Not expressible in Prisma and added by raw SQL migrations:
//  - search columns (tsvector, normalised text, phonetic key) and their GIN indexes
//  - the trigger that rejects circular category parents

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  si
  en
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum HomepageSectionType {
  HERO
  LATEST
  MOST_READ
  VIDEO
  TOP_STORIES
  CATEGORY_BLOCK
  QUICK_CATEGORIES
}

enum NavTargetType {
  CATEGORY
  URL
}

/// Stored poll status. Whether a poll is open for voting is always decided from
/// startsAt and endsAt at request time, never from this value alone.
enum PollStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum PollResultsVisibility {
  /// Anyone can see results while voting is open.
  ALWAYS
  /// A device sees results once it has voted; everyone sees them after closing.
  AFTER_VOTE
  /// Results appear only when voting has closed.
  AFTER_CLOSE
}

enum VoteIdentity {
  ANONYMOUS
  CODE_NAME
}

enum CommentStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum PollEventType {
  DUPLICATE_ATTEMPT
  RATE_LIMITED
  FRESH_DEVICE_BURST
  INVALID_DEVICE_TOKEN
  TOO_FAST
  HONEYPOT
  NOT_OPEN
}

// ───────────────────────── Articles ─────────────────────────

/// Shared, language-neutral article identity. Holds no reader-facing text.
model Article {
  id                String    @id @default(cuid())
  primaryCategoryId String
  authorId          String?
  featuredMediaId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Soft delete. Permanent deletion is a separate, confirmed admin action.
  deletedAt         DateTime?

  primaryCategory Category @relation("ArticlePrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  author          Author?  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  featuredMedia   Media?   @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: Restrict)

  translations ArticleTranslation[]
  /// Set when the automated newsroom created this article as a draft.
  newsroomStory NewsroomStory?
  categories   ArticleCategory[]
  tags         ArticleTag[]
  views        ArticleViewDaily[]
  featured     FeaturedArticle[]
  breaking     BreakingNews[]
  videos       Video[]

  @@index([primaryCategoryId])
  @@index([deletedAt])
}

/// One language version of an article. Edited, scheduled and published independently.
model ArticleTranslation {
  id              String        @id @default(cuid())
  articleId       String
  locale          Locale
  headline        String
  summary         String        @default("")
  /// ProseMirror JSON. Rendered server-side from an allow-list of node types.
  body            Json
  slug            String
  seoTitle        String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  status          ArticleStatus @default(DRAFT)
  /// When status is SCHEDULED, the article is treated as published once this time passes.
  scheduledAt     DateTime?
  publishedAt     DateTime?
  /// Last significant change to the public text (headline, summary or body) after
  /// first publication. Null when never changed since. Used for "Updated",
  /// dateModified and sitemap lastmod; status-only saves do not change it.
  modifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  article   Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisions ArticleRevision[]
  redirects SlugRedirect[]

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@index([locale, status, publishedAt(sort: Desc)])
  @@index([locale, status, scheduledAt])
}

/// Immutable snapshot of one translation at each save.
model ArticleRevision {
  id            String        @id @default(cuid())
  translationId String
  headline      String
  summary       String
  body          Json
  status        ArticleStatus
  note          String?
  createdAt     DateTime      @default(now())

  translation ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId, createdAt(sort: Desc)])
}

// ───────────────────────── Classification ─────────────────────────

/// Sections, categories and subcategories in one self-referencing tree (max depth 3).
model Category {
  id        String   @id @default(cuid())
  parentId  String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  translations     CategoryTranslation[]
  primaryArticles  Article[]             @relation("ArticlePrimaryCategory")
  articles         ArticleCategory[]
  navigationItems  NavigationItem[]
  homepageSections HomepageSection[]
  videos           Video[]

  @@index([parentId, sortOrder])
}

model CategoryTranslation {
  id              String  @id @default(cuid())
  categoryId      String
  locale          Locale
  name            String
  slug            String
  description     String?
  seoTitle        String?
  metaDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

/// Additional (non-primary) categories. Shared by both editions.
model ArticleCategory {
  articleId  String
  categoryId String

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  translations TagTranslation[]
  articles     ArticleTag[]
  videos       VideoTag[]
}

model TagTranslation {
  id     String @id @default(cuid())
  tagId  String
  locale Locale
  name   String
  slug   String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@unique([locale, slug])
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ───────────────────────── Authors, media, video ─────────────────────────

model Author {
  id           String   @id @default(cuid())
  photoMediaId String?
  createdAt    DateTime @default(now())

  photo        Media?              @relation("AuthorPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  translations AuthorTranslation[]
  articles     Article[]
}

model AuthorTranslation {
  id          String  @id @default(cuid())
  authorId    String
  locale      Locale
  displayName String
  bio         String?

  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, locale])
}

/// An uploaded image after validation and re-encoding.
model Media {
  id         String   @id @default(cuid())
  /// Generated name inside the storage backend. Never derived from the upload's filename.
  storageKey String   @unique
  mimeType   String
  width      Int
  height     Int
  sizeBytes  Int
  checksum   String
  credit     String?
  createdAt  DateTime @default(now())

  translations MediaTranslation[]
  articles     Article[]          @relation("ArticleFeaturedMedia")
  authors      Author[]           @relation("AuthorPhoto")
  videos       Video[]            @relation("VideoThumbnail")
  polls        Poll[]             @relation("PollFeaturedMedia")
  adsDesktop   Advertisement[]    @relation("AdDesktopImage")
  adsMobile    Advertisement[]    @relation("AdMobileImage")

  @@index([checksum])
}

model MediaTranslation {
  id      String  @id @default(cuid())
  mediaId String
  locale  Locale
  altText String
  caption String?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, locale])
}

model Video {
  id               String        @id @default(cuid())
  youtubeId        String
  durationSeconds  Int           @default(0)
  thumbnailMediaId String?
  articleId        String?
  categoryId       String?
  /// Kept from Increment 1. A video is public when status allows it AND this is true.
  isVisible        Boolean       @default(true)
  status           ArticleStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  isFeatured       Boolean       @default(false)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  deletedAt        DateTime?

  thumbnail    Media?             @relation("VideoThumbnail", fields: [thumbnailMediaId], references: [id], onDelete: SetNull)
  article      Article?           @relation(fields: [articleId], references: [id], onDelete: SetNull)
  category     Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations VideoTranslation[]
  tags         VideoTag[]

  @@index([isVisible, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
}

model VideoTranslation {
  id              String  @id @default(cuid())
  videoId         String
  locale          Locale
  title           String
  description     String?
  /// Null on rows created before video pages existed; such a video has no page in this language.
  slug            String?
  seoTitle        String?
  metaDescription String?

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, locale])
  @@unique([locale, slug])
}

model VideoTag {
  videoId String
  tagId   String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

// ───────────────────────── Navigation and homepage ─────────────────────────

model NavigationItem {
  id         String        @id @default(cuid())
  parentId   String?
  targetType NavTargetType
  categoryId String?
  url        String?
  sortOrder  Int           @default(0)
  isVisible  Boolean       @default(true)

  parent       NavigationItem?             @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationItem[]            @relation("NavigationTree")
  category     Category?                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations NavigationItemTranslation[]

  @@index([parentId, sortOrder])
}

model NavigationItemTranslation {
  id               String @id @default(cuid())
  navigationItemId String
  locale           Locale
  label            String

  navigationItem NavigationItem @relation(fields: [navigationItemId], references: [id], onDelete: Cascade)

  @@unique([navigationItemId, locale])
}

model HomepageSection {
  id         String              @id @default(cuid())
  type       HomepageSectionType
  sortOrder  Int                 @default(0)
  isEnabled  Boolean             @default(true)
  /// Set for CATEGORY_BLOCK sections.
  categoryId String?
  settings   Json?

  category     Category?                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations HomepageSectionTranslation[]

  @@index([isEnabled, sortOrder])
}

model HomepageSectionTranslation {
  id                String @id @default(cuid())
  homepageSectionId String
  locale            Locale
  heading           String

  homepageSection HomepageSection @relation(fields: [homepageSectionId], references: [id], onDelete: Cascade)

  @@unique([homepageSectionId, locale])
}

/// Hero carousel entry for one edition.
model FeaturedArticle {
  id        String    @id @default(cuid())
  articleId String
  locale    Locale
  position  Int       @default(0)
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale, position])
}

/// Ticker entry for one edition.
model BreakingNews {
  id         String    @id @default(cuid())
  articleId  String
  locale     Locale
  customText String?
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([locale, isActive, createdAt(sort: Desc)])
}

// ───────────────────────── Analytics and redirects ─────────────────────────

/// One counter per article, edition and day. Most Read sums the last N days.
model ArticleViewDaily {
  articleId String
  locale    Locale
  day       DateTime @db.Date
  count     Int      @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, locale, day])
  @@index([locale, day])
}

/// Old path kept so a moved or renamed article answers with a 301.
model SlugRedirect {
  id            String   @id @default(cuid())
  locale        Locale
  oldPath       String
  translationId String
  createdAt     DateTime @default(now())

  translation ArticleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([locale, oldPath])
}

// ───────────────────────── Public opinions (polls) ─────────────────────────

/// One poll, shared by both editions: one identity, one voting population.
model Poll {
  id                String                @id @default(cuid())
  /// Latin-script slug, the same in /si and /en.
  slug              String                @unique
  status            PollStatus            @default(DRAFT)
  isHidden          Boolean               @default(false)
  startsAt          DateTime
  endsAt            DateTime
  resultsVisibility PollResultsVisibility @default(AFTER_VOTE)
  featuredMediaId   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  /// Soft delete. Votes are never removed by deleting a poll from the admin portal.
  deletedAt         DateTime?

  featuredMedia Media?            @relation("PollFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  translations  PollTranslation[]
  options       PollOption[]
  events        PollEvent[]

  @@index([status, startsAt])
  @@index([status, endsAt])
}

model PollTranslation {
  id              String  @id @default(cuid())
  pollId          String
  locale          Locale
  question        String
  description     String  @default("")
  seoTitle        String?
  metaDescription String?

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, locale])
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  sortOrder Int    @default(0)

  poll         Poll                    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  translations PollOptionTranslation[]
  votes        PollVote[]

  /// Lets PollVote reference (optionId, pollId) together, so the database itself
  /// refuses a vote whose option belongs to a different poll.
  @@unique([id, pollId])
  @@index([pollId, sortOrder])
}

model PollOptionTranslation {
  id       String @id @default(cuid())
  optionId String
  locale   Locale
  label    String

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

/// One vote. The source of truth for results; there is no stored tally.
model PollVote {
  id         String       @id @default(cuid())
  pollId     String
  optionId   String
  /// HMAC of the device token. The token itself lives only in the visitor's cookie.
  deviceHash String
  identity   VoteIdentity @default(ANONYMOUS)
  codeName   String?
  /// Edition the vote was cast from. Informational; both editions share one tally.
  locale     Locale
  /// HMAC of the network address with a key that changes daily. Not reversible,
  /// not comparable across days. Used only for abuse detection.
  networkHash String?
  /// True when the device token was issued shortly before the vote.
  freshDevice Boolean     @default(false)
  createdAt  DateTime     @default(now())

  option  PollOption   @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Restrict)
  comment PollComment?

  /// One vote per recognised device per poll, enforced by the database.
  @@unique([pollId, deviceHash])
  @@index([pollId, optionId])
  @@index([pollId, createdAt])
  @@index([pollId, networkHash, createdAt])
}

/// Optional comment attached to a vote. Moderating or deleting it never touches the vote.
model PollComment {
  id          String        @id @default(cuid())
  voteId      String        @unique
  /// Plain text. Never rendered as HTML.
  body        String
  status      CommentStatus @default(PENDING)
  /// Set by automatic checks (links, repeated text) to help moderation.
  flagged     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  moderatedAt DateTime?

  vote PollVote @relation(fields: [voteId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

/// Rejected or suspicious voting attempts, for the admin's review. Holds no raw
/// identifiers and is meant to be purged after 30 days.
model PollEvent {
  id          String        @id @default(cuid())
  pollId      String?
  type        PollEventType
  deviceHash  String?
  networkHash String?
  createdAt   DateTime      @default(now())

  poll Poll? @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId, createdAt])
  @@index([type, createdAt])
  @@index([networkHash, createdAt])
}

// ───────────────────────── Site, admin, audit ─────────────────────────

// ───────────────────────── Automated newsroom ─────────────────────────

/// Single row (id = 1). Automation is off until an admin enables it after a successful manual run.
model NewsroomSettings {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  maxStoriesPerRun  Int      @default(2)
  /// Lock against overlapping runs: the run holding it and when the lock lapses.
  lockRunId         String?
  lockedUntil       DateTime?
  updatedAt         DateTime @updatedAt
}

enum NewsroomRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// One research run. slotKey makes each scheduled window run once ("2026-11-19T06:00+05:30"); manual runs use "manual-<id>".
model NewsroomRun {
  id            String            @id @default(cuid())
  slotKey       String            @unique
  trigger       String
  status        NewsroomRunStatus @default(RUNNING)
  attempt       Int               @default(1)
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  discovered    Int               @default(0)
  selected      Int               @default(0)
  duplicates    Int               @default(0)
  insufficient  Int               @default(0)
  copyright     Int               @default(0)
  drafted       Int               @default(0)
  held          Int               @default(0)
  failed        Int               @default(0)
  /// Plain-language reason for a failure or skip (never contains secrets).
  message       String?
  costUsd       Decimal           @default(0) @db.Decimal(12, 6)
  triggeredById String?

  stories NewsroomStory[]

  @@index([startedAt(sort: Desc)])
}

enum NewsroomStoryStatus {
  DRAFTED
  HELD
  REJECTED
  FAILED
  DISCARDED
}

enum CopyrightRisk {
  LOW
  MEDIUM
  HIGH
}

/// A story the research found, and what happened to it. Holds research notes and source
/// references, never copies of source articles.
model NewsroomStory {
  id             String              @id @default(cuid())
  runId          String
  topic          String
  status         NewsroomStoryStatus
  /// Why it was rejected, held or failed.
  reason         String?
  /// Normalised words of the topic and entities, for duplicate checks.
  fingerprint    String              @default("")
  /// Facts, sources (url, publisher, author, published, accessed), conflicts, notes.
  research       Json
  verification   String              @default("")
  copyrightRisk  CopyrightRisk?
  copyrightNotes String?
  /// Generated text for held stories, so an editor can review it before creating drafts.
  heldContent    Json?
  enHeadline     String?
  siHeadline     String?
  enWords        Int?
  siWords        Int?
  articleId      String?             @unique
  model          String?
  costUsd        Decimal             @default(0) @db.Decimal(12, 6)
  createdAt      DateTime            @default(now())

  run     NewsroomRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  article Article?    @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([status])
}

/// In-dashboard notifications. key makes one-off notices (budget warnings) appear once.
model NewsroomNotice {
  id        String    @id @default(cuid())
  key       String?   @unique
  level     String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([createdAt(sort: Desc)])
}

// ───────────────────────── Static pages ─────────────────────────

/// About, Contact and policy pages. A fixed set created by migration; the key
/// and the web address are fixed so links to them never break.
model StaticPage {
  id        String   @id @default(cuid())
  /// about | contact | privacy | terms | editorial
  key       String   @unique
  /// First path segment, the same in both languages: /si/about, /en/about.
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  translations StaticPageTranslation[]
}

/// One language version. Holds the working draft and, separately, the published
/// copy, so saving a draft never changes what visitors see.
model StaticPageTranslation {
  id              String   @id @default(cuid())
  pageId          String
  locale          Locale
  /// Working draft. Body is ProseMirror JSON, cleaned like article bodies.
  title           String   @default("")
  body            Json
  seoTitle        String   @default("")
  metaDescription String   @default("")
  /// Published copy, shown to visitors while isPublished is true.
  publishedTitle           String?
  publishedBody            Json?
  publishedSeoTitle        String?
  publishedMetaDescription String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  updatedAt       DateTime @updatedAt
  updatedById     String?

  page      StaticPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  updatedBy Admin?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageId, locale])
}

/// Single row (id = 1).
model SiteSettings {
  id                 Int      @id @default(1)
  siteName           String   @default("RSnewslk.com")
  mostReadWindowDays Int      @default(7)
  aiDailyTokenBudget Int      @default(200000)
  socialLinks        Json     @default("{}")
  /// Image used when a page has no image of its own (Facebook, WhatsApp, X). Null: the built-in brand image.
  defaultShareMediaId String?
  /// Hard monthly limit for all AI use on the site (Sri Lanka calendar month). Only admins can change it.
  aiMonthlyBudgetUsd  Decimal  @default(20) @db.Decimal(10, 2)
  /// Per-language values such as tagline and footer text, keyed by locale.
  localized          Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

/// The one administrator. Created by scripts/create-admin.ts, never by a web form.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Argon2id hash.
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions  AdminSession[]
  auditLogs AuditLog[]
  aiUsage   AiUsageLog[]
  staticPageEdits StaticPageTranslation[]
}

model AdminSession {
  id         String   @id @default(cuid())
  adminId    String
  /// SHA-256 of the session token. The token itself is never stored.
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Every login attempt, kept for rate limiting. Holds no address or password:
/// the email is hashed and the network is the daily-rotating keyed hash.
model LoginAttempt {
  id          String   @id @default(cuid())
  emailHash   String
  networkHash String?
  success     Boolean
  createdAt   DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([networkHash, createdAt])
}

/// Append-only record of administrative actions.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

/// One row per AI call. Stores counts only, never article text.
model AiUsageLog {
  id           String   @id @default(cuid())
  adminId      String?
  operation    String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean
  errorCode    String?
  /// Server-side tool calls billed with this request (web search is charged per search).
  webSearchRequests Int @default(0)
  webFetchRequests  Int @default(0)
  /// Set for requests made by the automated newsroom.
  newsroomRunId String?
  /// Estimated from the reported token counts and the list price; null when the model's price is unknown.
  estimatedCostUsd Decimal? @db.Decimal(12, 6)
  createdAt    DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([adminId, createdAt])
  @@index([newsroomRunId])
}

// ─────────────────────────── Advertising (own banners) ───────────────────────────

enum AdPlacement {
  TOP
  HOME_MID
  IN_ARTICLE
  IN_FEED
}

/// A banner sold directly to an advertiser. Several running banners in one
/// position take turns (see components/ads/AdRotator.tsx).
model Advertisement {
  id             String      @id @default(cuid())
  placement      AdPlacement
  advertiser     String
  /// Where a click goes. http(s) only; clicks pass through /go/ad/{id} to be counted.
  linkUrl        String
  desktopMediaId String?
  mobileMediaId  String?
  showSi         Boolean     @default(true)
  showEn         Boolean     @default(true)
  startsAt       DateTime
  endsAt         DateTime?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  desktopImage Media?       @relation("AdDesktopImage", fields: [desktopMediaId], references: [id], onDelete: Restrict)
  mobileImage  Media?       @relation("AdMobileImage", fields: [mobileMediaId], references: [id], onDelete: Restrict)
  stats        AdStatDaily[]

  @@index([placement, isActive])
}

/// Views and clicks per banner per Sri Lanka calendar day. No reader data.
model AdStatDaily {
  adId   String
  day    DateTime @db.Date
  views  Int      @default(0)
  clicks Int      @default(0)

  ad Advertisement @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@id([adId, day])
}
