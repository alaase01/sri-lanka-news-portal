# Copy to .env and fill in. Never commit .env.

# PostgreSQL 16+ with the pg_trgm and unaccent extensions available
DATABASE_URL="postgresql://rsnews:change-me@localhost:5432/rsnews?schema=public"

# Public origin of the site, no trailing slash (used for canonical URLs and CSRF origin checks)
SITE_URL="http://localhost:3000"

# Secret for the voting device cookie and vote hashes. Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it later makes every device look new, so past voters could vote again.
VOTE_SECRET=""

# Folder for uploaded images (relative to the project, or an absolute path).
# Must survive deployments and be included in backups. Optional; this is the default.
MEDIA_DIR="storage/media"

# AI Editorial Assistant (server only). Without a key the assistant shows "not configured".
# Never put a real key in this file or in git; set it only in the server's .env.
ANTHROPIC_API_KEY=""
# Model for rewriting and translation. Empty = claude-sonnet-5-5.
AI_MODEL=""
# Cheaper model for headline suggestions. Empty = claude-haiku-5-5.
AI_MODEL_LIGHT=""
# Reasoning effort: low, medium or high. Empty = medium.
AI_EFFORT=""
# Seconds to wait for an answer (10-600). Empty = 180.
AI_TIMEOUT_SECONDS=""
# Requests allowed per admin per hour / per 24 hours. Empty = 30 / 150.
AI_HOURLY_LIMIT=""
AI_DAILY_LIMIT=""

# Google Search Console "HTML tag" verification: paste only the content="…" value. Optional;
# not needed if you verify the domain with a DNS record instead.
GOOGLE_SITE_VERIFICATION=""
